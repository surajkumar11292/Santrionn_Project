# Application
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disaster_db
DB_USER=disaster_user
DB_PASSWORD=disaster_password_secure
DB_SSL=false
DB_POOL_MAX=20

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_disaster_platform_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_disaster_platform_2026
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
