# ==========================================
# Root Environment Configuration Template
# Copy to .env for Docker Compose overrides
# ==========================================

NODE_ENV=development
PORT=3000

# PostgreSQL Configuration
POSTGRES_DB=disaster_db
POSTGRES_USER=disaster_user
POSTGRES_PASSWORD=disaster_password_secure
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_disaster_platform_2026
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_disaster_platform_2026
CORS_ORIGIN=http://localhost:5173
